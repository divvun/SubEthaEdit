      <state id="SingleString" type="string" foldable="no" scope="string.single">
        <begin>
          <regex>'</regex>
        </begin>
        <end>
          <regex>((?&lt;!\\)(\\\\)*)'</regex>
        </end>
        <keywords id="SingleEscapes" useforautocomplete="no" scope="language.constant.numeric.character">
          <regex>\\(?:[\\'"`nrtbfv0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|u\{[0-9a-fA-F]{1,6}\})</regex>
        </keywords>
      </state>

      <state id="Block" type="block" foldable="yes" indent="yes" scope="meta.block">
        <begin>
          <regex>{</regex>
        </begin>
        <end>
          <regex>}</regex>
        </end>
        <import/>
      </state>

    </default>
  </states>
