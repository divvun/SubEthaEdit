      <keywords id="Numbers" useforautocomplete="no" scope="language.constant.numeric">
        <regex>(?&lt;![\w$])((?:0[xX][0-9a-fA-F_]+)|(?:0[oO][0-7_]+)|(?:0[bB][01_]+)|(?:[0-9][0-9_]*(?:\.[0-9_]*)?(?:[eE][+\-]?[0-9_]+)?))n?(?![\w$])</regex>
      </keywords>

      <keywords id="Decorators" useforautocomplete="no" scope="keyword.directive">
        <regex>@[A-Za-z_$][A-Za-z0-9_$]*</regex>
      </keywords>

      <keywords id="FunctionRegex" useforautocomplete="no" scope="language.subroutine.function">
        <regex>([A-Za-z0-9_$]+ *)\(</regex>
      </keywords>

      <state id="DocBlockComment" type="comment" scope="comment.block.documentation">
        <begin>
          <regex>/\*\*</regex>
        </begin>
        <end>
          <regex>\*/</regex>
        </end>
      </state>

      <state id="BlockComment" type="comment" scope="comment.block">
        <begin>
          <regex>/\*</regex>
        </begin>
        <end>
          <regex>\*/</regex>
        </end>
        <import mode="Base" state="EmailAndURLContainerState" keywords-only="yes"/>
      </state>

      <state id="LineComment" type="comment" scope="comment.line.double-slash">
        <begin>
          <regex>//</regex>
        </begin>
        <end>
          <regex>(?&lt;!\\)[\n\r]</regex>
        </end>
        <import mode="Base" state="EmailAndURLContainerState" keywords-only="yes"/>
      </state>

      <state id="Template" type="string" foldable="no" scope="string.double">
        <begin>
          <regex>`</regex>
        </begin>
        <end>
          <regex>((?&lt;!\\)(\\\\)*)`</regex>
        </end>
        <keywords id="TemplateEscapes" useforautocomplete="no" scope="language.constant.numeric.character">
          <regex>\\(?:[\\'"`nrtbfv0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|u\{[0-9a-fA-F]{1,6}\})</regex>
        </keywords>
        <state id="Interpolation" scope="meta.block.interpolation">
          <begin>
            <regex>\$\{</regex>
          </begin>
          <end>
            <regex>\}</regex>
          </end>
          <import/>
        </state>
      </state>

      <state id="String" type="string" foldable="no" scope="string.double">
        <begin>
          <regex>"</regex>
        </begin>
        <end>
          <regex>((?&lt;!\\)(\\\\)*)"</regex>
        </end>
        <keywords id="Escapes" useforautocomplete="no" scope="language.constant.numeric.character">
          <regex>\\(?:[\\'"`nrtbfv0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|u\{[0-9a-fA-F]{1,6}\})</regex>
        </keywords>
