<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The LSP host runs UNSANDBOXED (Developer ID / notarized, not App Store) so it
	     can read the user's PATH, locate language-server binaries in the usual install
	     dirs, and exec them directly without a per-binary security-scoped bookmark.
	     The main app stays sandboxed; only this small launcher process is not. -->
</dict>
</plist>
